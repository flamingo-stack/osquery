flowchart TD
    Start["Start Request"] --> Init["Initialize HTTP Request"]
    Init --> Resolve["DNS Resolve"]
    Resolve --> Connect["TCP Connect"]
    Connect --> TLSCheck{{"TLS Enabled?"}}
    TLSCheck -->|"Yes"| Handshake["SSL Handshake"]
    TLSCheck -->|"No"| Write
    Handshake --> Write["Async Write"]
